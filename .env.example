# Supabase Project Settings > API
# Estas duas variáveis são públicas e não concedem acesso privilegiado.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_PUBLISHABLE_KEY

# Única credencial usada pelo servidor para acessar tabelas e views.
# Nunca use prefixo VITE_ e nunca commite o valor real.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres
