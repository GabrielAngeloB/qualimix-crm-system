# Supabase — valores disponíveis em Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_PUBLISHABLE_O_ANON_KEY

# Segredo exclusivamente do servidor. NUNCA use prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=SUA_SECRET_O_SERVICE_ROLE_KEY

# Segredo temporário para criar o primeiro administrador.
# Gere um valor aleatório longo e remova a variável após o bootstrap.
BOOTSTRAP_ADMIN_SECRET=GERE_UM_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES
